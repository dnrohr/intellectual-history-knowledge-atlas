# Optional. Used only if you add hosted integrations that need to know the public URL.
APP_URL="http://localhost:3000"

# Optional. Hosting providers usually set this automatically.
PORT=3000

# Optional. When true, the frontend starts from bundled sample data on each load.
VITE_PUBLIC_DEMO_MODE=false

# Optional. Set this to the public Express service URL for static frontend hosts.
# Example: https://intellectual-history-knowledge-atlas.onrender.com
VITE_API_BASE_URL=""

# Optional. Comma-separated browser origins allowed to call the Express API.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
